NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Media Auth Secret (Used for signing short-lived JWTs to authorize media proxy requests)
MEDIA_SECRET_KEY=your_secure_random_string_min_32_chars

# Media Proxy URL (Where the proxy service is deployed, e.g., Cloudflare Worker or Cloud Run)
NEXT_PUBLIC_MEDIA_PROXY_URL=https://media-proxy.example.com

# Google Drive Credentials (Server-side ONLY)
GOOGLE_DRIVE_CLIENT_EMAIL=your_service_account_email@your_project.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id
